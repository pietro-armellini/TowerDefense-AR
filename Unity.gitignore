# =========================
# Unity AR/VR .gitignore
# =========================
# Official reference: https://github.com/github/gitignore/blob/main/Unity.gitignore

# =========================
# Unity Generated Folders
# =========================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Rr]ecordings/
UserSettings/

# =========================
# Auto-generated files
# =========================
sysinfo.txt
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.opendb
*.booproj
*.svd
*.pdb
*.mdb
*.pidb
*.VC.db

# =========================
# Visual Studio / Rider
# =========================
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
ExportedObj/
.consulo/
Assets/Plugins/Editor/JetBrains*

# =========================
# Android / iOS Builds
# =========================
*.apk
*.aab
*.app
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Crashlytics / Firebase
crashlytics-build.properties

# =========================
# Addressables / Asset Bundles
# =========================
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# =========================
# IDE / Editor
# =========================
.vscode/
.idea/
*.swp
*.DS_Store

# =========================
# Optional AR/VR runtime files
# =========================
# Memory snapshots
*.memsnap

# Profiling files
*.frameinfo
*.profiler

